# ============================================================
# DAWERE INTRANET - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ============================================================
# NEXTAUTH CONFIGURATION
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Your production URL (change to https://your-netlify-domain.netlify.app in production)
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# GOOGLE OAUTH (Google Workspace)
# ============================================================
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# For production: https://your-domain.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Allowed email domain (only @dawere.com emails can login)
ALLOWED_EMAIL_DOMAIN=dawere.com

# ============================================================
# AIRTABLE CONFIGURATION
# ============================================================
# Your Airtable Personal Access Token
# Create at: https://airtable.com/create/tokens
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_airtable_pat_here

# Your Airtable Base ID
AIRTABLE_BASE_ID=cVPstScheuVwJd

# Table names in Airtable
AIRTABLE_EMPLOYEES_TABLE=Empleados
AIRTABLE_LINKS_TABLE=Enlaces
